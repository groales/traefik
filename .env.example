# Imagen oficial de Traefik. Se puede fijar una etiqueta concreta en lugar de latest.
TRAEFIK_IMAGE=traefik:latest

# Por seguridad, los puertos se publican solo en la interfaz local por defecto.
# Cambia a 0.0.0.0 únicamente si necesitas acceso desde otras máquinas y
# configuras TLS y protección adecuada para el panel.
TRAEFIK_BIND_ADDRESS=127.0.0.1
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# Nivel de logs de Traefik: DEBUG, INFO, WARN o ERROR.
TRAEFIK_LOG_LEVEL=INFO
